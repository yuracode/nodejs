<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
    <link rel='stylesheet' href='/stylesheets/userManage.css' />
</head>
<body>
    <h1><%= title %></h1>
    <p><a href="/">← トップページに戻る</a></p>

    <!-- メッセージ表示エリア -->
    <div id="message"></div>

    <!-- ユーザー追加フォーム -->
    <div class="add-user-form">
        <h2>新規ユーザー追加</h2>
        <input type="text" id="newUserName" placeholder="ユーザー名を入力">
        <button onclick="addUser()">追加</button>
    </div>

    <!-- ユーザー一覧 -->
    <div class="user-list">
        <h2>ユーザー一覧</h2>
        <div id="userList">
            <!-- ユーザーリストが JavaScript で動的に挿入されます -->
        </div>
    </div>

    <!-- JavaScript を読み込む -->
    <!-- <script src="/javascripts/userManage.js"></script> -->
</body>
</html>
